# Пример файла конфигурации для развертывания
# Скопируйте этот файл в .env и настройте под ваши нужды

# Домен (для production с SSL)
DOMAIN=your-domain.com

# Порт на котором будет работать приложение (для docker-compose)
PORT=80

# Таймзона
TZ=Europe/Moscow

# Режим (development/production)
NODE_ENV=production
